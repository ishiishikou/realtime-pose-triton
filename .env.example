VITE_API_BASE_URL=http://localhost:8080
VITE_WEBRTC_CONFIG=
TRITON_GRPC_URL=triton:8001
POSE_MODEL_NAME=rtmpose
# Empty input/output names enable Triton metadata auto-detection.
POSE_INPUT_NAME=
POSE_OUTPUT_NAME=
POSE_INPUT_WIDTH=192
POSE_INPUT_HEIGHT=256
POSE_NORMALIZE=1
POSE_TARGET_FPS=10
# Real Triton inference is the default. Set to 1 for camera/WebRTC-only local checks.
POSE_MOCK_MODE=0
RTMPOSE_ONNX_URL=
RTMPOSE_ONNX_PATH=/models/rtmpose/1/model.onnx

# VLM runs independently from pose inference. Set 0 to disable periodic VLM analysis.
VLM_TARGET_INTERVAL_SECONDS=30
VLM_TRITON_GRPC_URL=vlm-triton:8001
VLM_MODEL_NAME=smolvlm_256m_cpu
VLM_MODEL_ID=HuggingFaceTB/SmolVLM-256M-Instruct
VLM_PROMPT=Describe the main person and what they are doing in one short sentence.
VLM_MAX_NEW_TOKENS=24
VLM_ORT_THREADS=2
