VITE_API_BASE_URL=/api
VITE_WEBRTC_CONFIG=
TRITON_GRPC_URL=triton:8001
POSE_MODEL_NAME=rtmpose
# Empty input/output names enable Triton metadata auto-detection.
POSE_INPUT_NAME=
POSE_OUTPUT_NAME=
POSE_INPUT_WIDTH=192
POSE_INPUT_HEIGHT=256
POSE_NORMALIZE=1
POSE_TARGET_FPS=10
# Real Triton inference is the default. Set to 1 for camera/WebRTC-only local checks.
POSE_MOCK_MODE=0
RTMPOSE_ONNX_URL=
RTMPOSE_ONNX_PATH=/models/rtmpose/1/model.onnx

# MediaMTX + CPU-only VLM narration. Keep actual RTSP base URLs and credentials in .env/.env.local only.
VITE_MEDIAMTX_WEBRTC_BASE_URL=
VITE_MEDIAMTX_STREAM_PATH=live/iphone-001
# Local PoC example credentials shared with mediamtx-playground. Override for other environments.
VITE_MEDIAMTX_PUBLISHER_USER=poc-publisher
VITE_MEDIAMTX_PUBLISHER_PASSWORD=poc-publisher-pass
NARRATION_RTSP_BASE_URL=
NARRATION_ALLOWED_PATH_PREFIX=live/
NARRATION_RTSP_TRANSPORT=tcp
NARRATION_RTSP_RECONNECT_SECONDS=2
VLM_TRITON_GRPC_URL=vlm-triton:8001
VLM_MODEL_NAME=smolvlm_256m_cpu
VLM_NARRATION_INTERVAL_SECONDS=3
VLM_NARRATION_PROMPT=Describe what is happening in this image in one short sentence.
VLM_NARRATION_JPEG_QUALITY=80
VLM_MODEL_ID=HuggingFaceTB/SmolVLM-256M-Instruct
VLM_MAX_NEW_TOKENS=24
VLM_ORT_THREADS=0
